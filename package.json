{
  "name": "spectra-cse-club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
"dev:api": "npm run build && npx wrangler pages dev out",
    "build": "next build",
    "start": "npx wrangler pages dev out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "placeholders": "node scripts/placeholders.mjs",
    "prebuild": "node scripts/placeholders.mjs",
    "format": "prettier --write .",
    "fonts": "node scripts/sync-fonts.mjs",
    "contrast": "node scripts/contrast.mjs",
    "check": "npm run typecheck && eslint . && node scripts/contrast.mjs",
    "db:migrate:local": "wrangler d1 migrations apply spectra-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply spectra-db --remote",
    "db:seed:local": "tsx scripts/db/seed.ts --local",
    "db:seed:remote": "tsx scripts/db/seed.ts --remote",
    "admin:create:local": "tsx scripts/db/create-admin.ts --local",
    "admin:create:remote": "tsx scripts/db/create-admin.ts --remote",
    "preview": "npm run build && wrangler pages dev out",
    "deploy": "npm run build && wrangler pages deploy out --project-name spectra-cse-aitr",
    "test": "node --import tsx --test tests/unit.test.ts",
    "test:e2e": "node --import tsx tests/e2e.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "framer-motion": "^13.4.6",
    "lucide-react": "^1.48.0",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "@cloudflare/workers-types": "^5.20261029.1",
    "tsx": "^4.23.15",
    "wrangler": "^4.156.0"
  }
}
